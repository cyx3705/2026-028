@echo off
setlocal enabledelayedexpansion
cd /d "%~dp0"
echo.
echo   Minimal IM - bridge installer
echo   ------------------------------
echo.
echo   [1/3] unpacking bridge.cs ...
if exist bridge.cs.b64 del bridge.cs.b64
> bridge.cs.b64 echo 
>> bridge.cs.b64 echo 
>> bridge.cs.b64 echo 
>> bridge.cs.b64 echo 
>> bridge.cs.b64 echo 
>> bridge.cs.b64 echo 
>> bridge.cs.b64 echo 
>> bridge.cs.b64 echo 
>> bridge.cs.b64 echo 
>> bridge.cs.b64 echo 
>> bridge.cs.b64 echo 
>> bridge.cs.b64 echo 
>> bridge.cs.b64 echo 
>> bridge.cs.b64 echo 
>> bridge.cs.b64 echo 
>> bridge.cs.b64 echo 
>> bridge.cs.b64 echo 
>> bridge.cs.b64 echo 
>> bridge.cs.b64 echo 
>> bridge.cs.b64 echo 
>> bridge.cs.b64 echo 
>> bridge.cs.b64 echo 
>> bridge.cs.b64 echo 
>> bridge.cs.b64 echo 
>> bridge.cs.b64 echo 
>> bridge.cs.b64 echo 

echo   [2/3] compiling with the C# compiler bundled in Windows ...
set CSC=C:\Windows\Microsoft.NET\Framework64\v4.0.30319\csc.exe
if not exist "%CSC%" set CSC=C:\Windows\Microsoft.NET\Framework\v4.0.30319\csc.exe
if not exist "%CSC%" (
  echo   [X] csc.exe not found. .NET Framework 4.x is required.
  pause & exit /b 1
)
powershell -NoProfile -Command "$b=(Get-Content -Raw bridge.cs.b64) -replace '\s',''; [IO.File]::WriteAllBytes('bridge.cs', [Convert]::FromBase64String($b))"
if not exist bridge.cs ( echo   [X] unpack failed. & pause & exit /b 1 )
del bridge.cs.b64
"%CSC%" /nologo /target:exe /platform:anycpu /out:bridge.exe /r:System.dll /r:System.Drawing.dll /r:System.Web.Extensions.dll bridge.cs
if errorlevel 1 ( echo   [X] build failed. & pause & exit /b 1 )

echo   [3/3] starting bridge ...
echo.
echo   Bridge is running. Keep this window open.
echo   Now go back to the page - it reconnects by itself.
echo.
bridge.exe
pause
